# curl's settings for every request CI makes (CURL_HOME points here in each workflow): a network request is the one
# step that may fail for reasons outside the code, so each is tried again before the job fails. Tries back off from
# 1 s, doubling (curl's own, with no retry-delay): 8 retries ride out an outage of about 8 minutes, connect timeouts
# included (2026-11-26: github.com refused connects from one runner for over 3 minutes, past 5 tries 3 s apart)
retry = 8
retry-all-errors
connect-timeout = 30
