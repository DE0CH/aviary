{
  "product": {
    "name": "YYC AI",
    "locale": "zh-HK"
  },
  "models": [
    {
      "id": "deepseek/deepseek-v4.1-flash-1017",
      "label": "DeepSeek V4.1 Flash",
      "harness": "qwen",
      "reasoning": "high",
      "thinking": [
        "none",
        "low",
        "high",
        "max"
      ],
      "providers": [
        "deepinfra/fp8",
        "morph/fp8"
      ]
    },
    {
      "id": "xiaomi/mimo-v2.6-pro",
      "label": "MiMo v2.6 Pro",
      "harness": "qwen",
      "providers": [
        "deepinfra/fp8"
      ]
    }
  ],
  "defaultModel": "deepseek/deepseek-v4.1-flash-1017",
  "smallModel": "deepseek/deepseek-v4.1-flash-1017",
  "titleModel": "deepseek/deepseek-v4.1-flash-1017",
  "titleReasoning": "none",
  "contextTokens": 1048576,
  "embedding": {
    "id": "qwen/qwen3-embedding-8b",
    "queryInstruction": "Instruct: Given a search query, retrieve the messages of a person's chat conversations that are relevant to it\nQuery: "
  },
  "routes": [
    {
      "name": "model",
      "upstream": "https://openrouter.ai/api",
      "model": true,
      "inject": {
        "Authorization": "Bearer ${OPENROUTER_API_KEY}"
      },
      "allowPaths": [
        "/v1/messages",
        "/v1/chat/completions",
        "/v1/embeddings"
      ]
    },
    {
      "name": "tools",
      "upstream": "http://tools",
      "allowPaths": [
        "/v1/"
      ],
      "inject": {
        "Authorization": "Bearer ${EGRESS_TOKEN_TOOLS}"
      },
      "timeoutSeconds": 180
    },
    {
      "name": "telegram",
      "upstream": "http://herald",
      "allowPaths": [
        "/v1/"
      ],
      "inject": {
        "Authorization": "Bearer ${EGRESS_TOKEN_HERALD}"
      },
      "timeoutSeconds": 330
    },
    {
      "name": "feishu-files",
      "upstream": "http://feishu-index.feishu-index.svc.cluster.local",
      "allowPaths": [
        "/v1/"
      ],
      "inject": {
        "Authorization": "Bearer ${EGRESS_TOKEN_FEISHU_FILES}"
      },
      "identityHeaders": {
        "X-Jarvis-Conversation": "conversation"
      },
      "timeoutSeconds": 180
    },
    {
      "name": "labels",
      "upstream": "https://labels.yyc-internal.com",
      "inject": {
        "CF-Access-Client-Id": "${LABELS_AI_CLIENT_ID}",
        "CF-Access-Client-Secret": "${LABELS_AI_CLIENT_SECRET}"
      },
      "allowPaths": [
        "/api/v1/",
        "/api/v2/"
      ],
      "identityHeaders": {
        "X-Jarvis-Conversation": "conversation"
      },
      "timeoutSeconds": 180
    },
    {
      "name": "code",
      "upstream": "https://github.com",
      "inject": {
        "Authorization": "Basic ${CODE_GITHUB_BASIC}"
      },
      "allowPaths": [
        "/DE0CH/yyc-code/"
      ],
      "identity": false,
      "timeoutSeconds": 300
    }
  ],
  "selfHosts": [
    "10.202.1.1",
    "egress",
    "egress.yyc-ai",
    "egress.yyc-ai.svc",
    "egress.yyc-ai.svc.cluster.local"
  ],
  "generatedAllowlist": true,
  "defaultAllowedHosts": [],
  "denyHosts": [],
  "blockCidrs": [],
  "maxUploadBytes": 8388608,
  "cacheGiB": 5,
  "budget": {
    "limitUsd": 100,
    "since": "2026-10-21T02:05:52Z",
    "ownerName": "Deyao"
  },
  "exit": {
    "socks": "socks.egress.svc.cluster.local:1080",
    "sandboxProfile": "sandbox"
  }
}
