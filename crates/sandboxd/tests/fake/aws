#!/usr/bin/env python3
# A stand-in for the AWS CLI in sandboxd's tests: `aws s3 cp - s3://B/K` stores stdin as $FAKE_S3/B/K (whole, or not at
# all, as S3 shows an object), `aws s3 cp s3://B/K -` writes it to stdout. It refuses to run without the four
# credentials a freeze hands it, and if it was ever handed the freeze's key (that is seal's alone).
import os, shutil, sys
a = [x for x in sys.argv[1:] if not x.startswith("--")]
if "--expected-size" in sys.argv:
    a = [x for x in a if x != sys.argv[sys.argv.index("--expected-size") + 1]]
for k in ("AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN", "AWS_DEFAULT_REGION"):
    if not os.environ.get(k):
        print(f"fake aws: no {k}", file=sys.stderr); sys.exit(255)
if "SBX_SEAL_KEY" in os.environ:
    print("fake aws: it was handed the freeze's key", file=sys.stderr); sys.exit(254)
if a[:2] != ["s3", "cp"] or len(a) != 4:
    print("fake aws: only s3 cp SRC DST", file=sys.stderr); sys.exit(2)
src, dst = a[2], a[3]
def path(u):
    b, k = u[len("s3://"):].split("/", 1)
    return os.path.join(os.environ["FAKE_S3"], b, k)
if src == "-":
    p = path(dst); os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p + ".part", "wb") as f:
        shutil.copyfileobj(sys.stdin.buffer, f)
    os.replace(p + ".part", p)
elif dst == "-":
    p = path(src)
    if not os.path.exists(p):
        print(f"fatal error: An error occurred (404) when calling the HeadObject operation: Key not found", file=sys.stderr); sys.exit(1)
    with open(p, "rb") as f:
        shutil.copyfileobj(f, sys.stdout.buffer)
else:
    print("fake aws: one side must be -", file=sys.stderr); sys.exit(2)
